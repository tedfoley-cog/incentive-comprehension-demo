//INCDAILY JOB (ACCT#),'INCENTIVE DAILY',CLASS=A,MSGCLASS=X,
//             REGION=0M,NOTIFY=&SYSUID
//*--------------------------------------------------------------------*
//* INCDAILY - NIGHTLY DEALER-INCENTIVE CLAIM PROCESSING               *
//*                                                                    *
//* RUNS AFTER THE CLAIM FEED (INCFEED) HAS LANDED. STEP010 EDITS AND  *
//* ADJUDICATES EVERY CLAIM AND WRITES THE PAYOUT REGISTER, WHICH IS   *
//* THEN REPORTED (STEP020) AND HANDED TO THE GL FEED (INCGLFD).       *
//*                                                                    *
//* SCHEDULED BY:  SEE scheduler/SCHEDULE.txt (JOB INCDAILY)           *
//* DD CONTRACT :  CLAIMS/DEALERS/PROGRAMS IN, PAYOUT OUT (LRECL 80)   *
//*--------------------------------------------------------------------*
//STEP010  EXEC PGM=INCMAIN
//STEPLIB  DD DSN=OEM.INCENT.LOADLIB,DISP=SHR
//*        DAILY CLAIM FEED (GDG, CURRENT GENERATION)
//CLAIMS   DD DSN=OEM.INCENT.CLAIMS(+0),DISP=SHR
//*        DEALER + PROGRAM MASTERS
//DEALERS  DD DSN=OEM.INCENT.DEALER.MASTER,DISP=SHR
//PROGRAMS DD DSN=OEM.INCENT.PROGRAM.MASTER,DISP=SHR
//*        PAYOUT REGISTER (NEW GENERATION)
//PAYOUT   DD DSN=OEM.INCENT.PAYOUT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,2),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//*
//*        REPORTING STEP ONLY RUNS IF ADJUDICATION SUCCEEDED
//STEP020  EXEC PGM=INCRPT,COND=(0,NE,STEP010)
//STEPLIB  DD DSN=OEM.INCENT.LOADLIB,DISP=SHR
//PAYOUT   DD DSN=OEM.INCENT.PAYOUT(+0),DISP=SHR
//INCRPT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//
